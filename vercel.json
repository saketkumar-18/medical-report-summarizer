{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "maxDuration": 60,
        "memory": 1024,
        "includeFiles": "static/**, data/**"
      }
    }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "/api/index.py" }
  ],
  "env": {
    "MEDSUMM_DEPLOYMENT": "serverless",
    "MEDSUMM_RATE_LIMIT_ENABLED": "true"
  }
}
